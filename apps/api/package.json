{
  "name": "@overview/api",
  "version": "0.0.0",
  "private": true,
  "description": "The sync API: Fastify on Postgres, the server half of the sync engine (docs/architecture/api.md, docs/features/sync-api.md). @overview is a placeholder scope \u2014 product naming is parked (docs/architecture/v1-architecture-decisions.md).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "start": "node dist/server.js",
    "dev": "npm run build && node --env-file=../../.env --env-file-if-exists=../../.env.local dist/server.js",
    "mint-session": "npm run build && node --env-file=../../.env --env-file-if-exists=../../.env.local dist/scripts/mintSession.js",
    "set-plan": "npm run build && node --env-file=../../.env --env-file-if-exists=../../.env.local dist/scripts/setPlan.js",
    "seed-voice-samples": "npm run build && node --env-file=../../.env --env-file-if-exists=../../.env.local dist/scripts/seedVoiceSamples.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "@overview/domain": "*",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@overview/store-conformance": "*",
    "@overview/store-local": "*",
    "@overview/sync": "*",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3"
  }
}
