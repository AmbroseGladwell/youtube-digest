{
  "name": "@overview/extension",
  "version": "0.0.0",
  "private": true,
  "description": "The Chrome MV3 shell: a side panel and a full page, each mounting @overview/app-core against the extension origin's own local IndexedDB. @overview is a placeholder scope — product naming is parked.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@overview/app-core": "*",
    "@overview/store-local": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sass": "^1.104.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  }
}
