use flake
PATH_add node_modules/.bin
# The Bitwarden account lives on the EU server; bws defaults to the US one and answers
# invalid_client against the wrong region (docs/conventions/secrets.md).
export BWS_SERVER_URL="${BWS_SERVER_URL:-https://vault.bitwarden.eu}"
# The one long-lived secret on this machine: the Bitwarden machine access token, kept in the
# login keychain by `task secrets:login` (docs/conventions/secrets.md).
if [ -z "${BWS_ACCESS_TOKEN:-}" ] && command -v security > /dev/null 2>&1; then
  export BWS_ACCESS_TOKEN="$(security find-generic-password -s overview-bws -w 2> /dev/null || true)"
fi
