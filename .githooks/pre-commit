#!/usr/bin/env bash
# Refuses a commit that stages a secret value. Only ever reads what is staged
# (docs/conventions/secrets.md).
if ! command -v gitleaks > /dev/null 2>&1; then
  echo "pre-commit: gitleaks is not on the path; enter the dev shell (direnv allow, or nix develop) or commit with --no-verify" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
